# Copy to .env (make env) and replace every change-me value. Never commit .env.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=editalmind
MYSQL_USER=editalmind
MYSQL_PASSWORD=change-me-mysql
MYSQL_PORT=3307

# MongoDB (Atlas Local, with Vector Search)
MONGO_ROOT_USERNAME=editalmind
MONGO_ROOT_PASSWORD=change-me-mongo
MONGO_PORT=27017

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible storage); the password needs at least 8 characters
MINIO_ROOT_USER=editalmind
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=editalmind-editais

# Mailpit (fake SMTP server with a web inbox)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Application services (make up-apps)
API_PORT=8000
AI_API_PORT=8001
WEB_PORT=8080
